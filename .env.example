# Nucleus — every knob, with working local defaults.
#
#     cp .env.example .env && docker compose up
#
# Copying this file unchanged produces a working stack. Nothing here is a
# secret you must supply before the platform will start; the values that would
# be secrets in a real deployment are marked, and are dev-only as they stand.

# ── Ports on the host ────────────────────────────────────────────────────
# PostgreSQL and Redis are published on non-default ports so the stack does not
# collide with a database you already run locally.
POSTGRES_PORT=5433
REDIS_PORT=6380
KEYCLOAK_PORT=8080
API_PORT=5101
FRONTEND_PORT=5174

# ── Environment ──────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO

# CHANGE THIS IN ANY DEPLOYMENT. Flask signs with it.
SECRET_KEY=dev-only-change-me

# ── API ──────────────────────────────────────────────────────────────────
# Gunicorn gevent workers. Each opens its own database pool, so this
# multiplies DB_POOL_SIZE — two is right for a laptop.
WEB_CONCURRENCY=2

# Everything is served under this prefix, and it must match the namespace name
# in backend/maps/endpoint.json. Changing one without the other serves the API
# somewhere nothing looks for it.
API_PREFIX=/platform

# ── Database ─────────────────────────────────────────────────────────────
# Set only when running the backend on the host rather than in compose; the
# stack builds its own from the service name.
# DATABASE_URL=postgresql+psycopg2://platform:platform@localhost:5433/platform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Cache ────────────────────────────────────────────────────────────────
# An optimisation, never a dependency: with this off, or with Redis
# unreachable, every helper degrades to a miss and readiness still passes.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

# ── Keycloak ─────────────────────────────────────────────────────────────
# Dev-only bootstrap credentials for the Keycloak admin console.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# The realm ships in keycloak/realm-template.json with five demo users. Each
# password is the username again — dev-only, and the realm is not a deployment
# artefact:
#
#   username   password   role            what they can do
#   admin      admin      administrator   unrestricted
#   manager    manager    manager         teams, operational data, reporting
#   operator   operator   operator        records and task queues
#   analyst    analyst    analyst         dashboards, reports, export
#   user       user       viewer          read-only
#
# Their emails are <username>@nucleus.example.
#
# The seed creates matching profiles, so signing in adopts a populated account
# rather than provisioning an empty one.

# ── Seeding ──────────────────────────────────────────────────────────────
# full  ≈ 15 500 rows across 50 tables
# small ≈ 1 750 rows, for iterating quickly
SEED_SCALE=full

# The same value reproduces the same graph, ids included — which is what lets a
# screenshot, a bookmark or a URL in a ticket survive a reseed.
SEED_RANDOM_SEED=20260101

# Passed to `python -m src.seed`. The seed refuses to run against a database
# that already has data; --reset drops and rebuilds.
# SEED_ARGS=--reset

# ── Observability ────────────────────────────────────────────────────────
ENABLE_TRACING=false
# QSINT_OTLP_ENDPOINT=http://jaeger:4317

# ── Storage ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
