{
  "realm": "template",
  "displayName": "Nucleus Template Platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "administrator",
        "description": "Unrestricted access, including the administration area."
      },
      {
        "name": "manager",
        "description": "Manages teams, operational data and reporting."
      },
      {
        "name": "operator",
        "description": "Works the operational record and task queues."
      },
      {
        "name": "analyst",
        "description": "Dashboards, reports, search and export. Read-only on records."
      },
      {
        "name": "viewer",
        "description": "Read-only access to records, tasks and dashboards."
      }
    ]
  },
  "clients": [
    {
      "clientId": "template-api",
      "name": "Template Platform API",
      "description": "Resource server. Access tokens carry this client id as their audience.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "template-spa",
      "name": "Template Platform SPA",
      "description": "Browser application. Authorization Code + PKCE, no client secret.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:5174",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5174/*",
        "http://localhost:3000/*",
        "http://localhost:8090/*",
        "http://localhost/*",
        "http://127.0.0.1:5174/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5174/*##http://localhost:3000/*##http://localhost:8090/*##http://localhost/*"
      },
      "protocolMappers": [
        {
          "name": "template-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "template-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-in-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@nucleus.example",
      "firstName": "Ada",
      "lastName": "Administrator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["administrator"]
    },
    {
      "username": "user",
      "email": "user@nucleus.example",
      "firstName": "Uma",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "user", "temporary": false }],
      "realmRoles": ["viewer"]
    },
    {
      "username": "manager",
      "email": "manager@nucleus.example",
      "firstName": "Mara",
      "lastName": "Manager",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "manager", "temporary": false }],
      "realmRoles": ["manager"]
    },
    {
      "username": "operator",
      "email": "operator@nucleus.example",
      "firstName": "Otto",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "operator", "temporary": false }],
      "realmRoles": ["operator"]
    },
    {
      "username": "analyst",
      "email": "analyst@nucleus.example",
      "firstName": "Ana",
      "lastName": "Analyst",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "analyst", "temporary": false }],
      "realmRoles": ["analyst"]
    }
  ]
}
